// Emulated IFNOT/WHILENOT AND/OR when GOTO_IF_TRUE unsupported.
// RUN: %gta3sc %s --config=gtavc -fifnot -emit-ir2 -o - | %FileCheck %s

VAR_INT x

// CHECK-NEXT-L: ANDOR 2i8
// CHECK-NEXT-L: IS_INT_VAR_EQUAL_TO_NUMBER &8 1i8
// CHECK-NEXT-L: IS_INT_VAR_EQUAL_TO_NUMBER &8 2i8
// CHECK-NEXT-L: IS_INT_VAR_EQUAL_TO_NUMBER &8 3i8
// CHECK-NEXT-L: GOTO_IF_FALSE @MAIN_1
// CHECK-NEXT-L: GOTO @MAIN_2
IFNOT x = 1
AND x = 2
AND x = 3
    // CHECK-NEXT-L: MAIN_1:
    // CHECK-NEXT-L: WAIT 1i8
    // CHECK-NEXT-L: NOP
    WAIT 1
    NOP
ENDIF

// CHECK-NEXT-L: MAIN_2:
// CHECK-NEXT-L: ANDOR 22i8
// CHECK-NEXT-L: IS_INT_VAR_EQUAL_TO_NUMBER &8 1i8
// CHECK-NEXT-L: IS_INT_VAR_EQUAL_TO_NUMBER &8 2i8
// CHECK-NEXT-L: IS_INT_VAR_EQUAL_TO_NUMBER &8 3i8
// CHECK-NEXT-L: GOTO_IF_FALSE @MAIN_3
// CHECK-NEXT-L: GOTO @MAIN_4
IFNOT x = 1
OR x = 2
OR x = 3
    // CHECK-NEXT-L: MAIN_3:
    // CHECK-NEXT-L: WAIT 2i8
    // CHECK-NEXT-L: NOP
    WAIT 2
    NOP
ENDIF

// CHECK-NEXT-L: MAIN_4:
// CHECK-NEXT-L: ANDOR 1i8
// CHECK-NEXT-L: IS_INT_VAR_EQUAL_TO_NUMBER &8 1i8
// CHECK-NEXT-L: IS_INT_VAR_EQUAL_TO_NUMBER &8 2i8
// CHECK-NEXT-L: GOTO_IF_FALSE @MAIN_5
IFNOT x = 1
AND x = 2
    // CHECK-NEXT-L: WAIT 4i8
    // CHECK-NEXT-L: NOP
    // CHECK-NEXT-L: GOTO @MAIN_6
    // CHECK-NEXT-L: MAIN_5:
    // CHECK-NEXT-L: WAIT 3i8
    // CHECK-NEXT-L: NOP
    WAIT 3
    NOP
ELSE
    WAIT 4
    NOP
ENDIF

// CHECK-NEXT-L: MAIN_6:
// CHECK-NEXT-L: ANDOR 21i8
// CHECK-NEXT-L: IS_INT_VAR_EQUAL_TO_NUMBER &8 1i8
// CHECK-NEXT-L: IS_INT_VAR_EQUAL_TO_NUMBER &8 2i8
// CHECK-NEXT-L: GOTO_IF_FALSE @MAIN_7
IFNOT x = 1
OR x = 2
    // CHECK-NEXT-L: WAIT 6i8
    // CHECK-NEXT-L: NOP
    // CHECK-NEXT-L: GOTO @MAIN_8
    // CHECK-NEXT-L: MAIN_7:
    // CHECK-NEXT-L: WAIT 5i8
    // CHECK-NEXT-L: NOP
    WAIT 5
    NOP
ELSE
    WAIT 6
    NOP
ENDIF

// CHECK-NEXT-L: MAIN_8:
// CHECK-NEXT-L: ANDOR 1i8
// CHECK-NEXT-L: IS_INT_VAR_EQUAL_TO_NUMBER &8 1i8
// CHECK-NEXT-L: IS_INT_VAR_EQUAL_TO_NUMBER &8 2i8
// CHECK-NEXT-L: GOTO_IF_FALSE @MAIN_9
// CHECK-NEXT-L: GOTO @MAIN_10
WHILENOT x = 1
AND x = 2
    // CHECK-NEXT-L: MAIN_9:
    // CHECK-NEXT-L: WAIT 10i8
    // CHECK-NEXT-L: NOP
    // CHECK-NEXT-L: GOTO @MAIN_8
    WAIT 10
    NOP
ENDWHILE

// CHECK-NEXT-L: MAIN_10:
// CHECK-NEXT-L: ANDOR 21i8
// CHECK-NEXT-L: IS_INT_VAR_EQUAL_TO_NUMBER &8 1i8
// CHECK-NEXT-L: IS_INT_VAR_EQUAL_TO_NUMBER &8 2i8
// CHECK-NEXT-L: GOTO_IF_FALSE @MAIN_11
// CHECK-NEXT-L: GOTO @MAIN_12
WHILENOT x = 1
OR x = 2
    // CHECK-NEXT-L: MAIN_11:
    // CHECK-NEXT-L: WAIT 11i8
    // CHECK-NEXT-L: NOP
    // CHECK-NEXT-L: GOTO @MAIN_10
    WAIT 11
    NOP
ENDWHILE

// CHECK-NEXT-L: MAIN_12:
// CHECK-NEXT-L: TERMINATE_THIS_SCRIPT
TERMINATE_THIS_SCRIPT
